# Transport: "http" for remote/gateway use (recommended), "stdio" for local Claude Desktop config
TRANSPORT=http
PORT=8108

# HTTP mode fails closed without this — every /mcp request must send it
# as X-API-Key. This server exposes filesystem write + shell exec within
# ALLOWED_ROOT; there is no other auth layer in front of it.
COMMANDER_API_KEY=your_commander_key_here

# Bind address for HTTP mode. Defaults to 127.0.0.1 (loopback only) even
# if unset — only widen this if you have another layer of auth/network
# isolation in front of it (e.g. Cloudflare Access, a VPN-only interface).
HOST=127.0.0.1

# HARD CEILING for every filesystem/process tool. Everything this server
# can touch lives under this path. Cannot be widened at runtime by any tool.
ALLOWED_ROOT=/data

# Shell used by proc_start when the caller doesn't specify one
DEFAULT_SHELL=/bin/bash
